{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run",
      "icon": {
        "id": "wrench",
        "color": "terminal.ansiGreen"
      },
      "type": "cargo",
      "command": "run",
      "args": [
        "--example",
        "main",
      ],
      "runOptions": {
        "instanceLimit": 1,
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "revealProblems": "onProblem",
        "close": false,
      },
      "group": {
        "kind": "build",
        "isDefault": false,
      },
    },
  ]
}